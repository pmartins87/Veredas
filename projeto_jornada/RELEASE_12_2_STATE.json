{
  "schema_version": 3,
  "roadmap_step": "12.2",
  "formal_status": "in_progress",
  "updated_on": "2026-08-13",
  "android": {
    "application_id": "com.pmartins87.veredasdatrama",
    "application_id_status": "persisted_in_debug_and_play_presets",
    "version_name": "0.1.0-dev",
    "version_code": 1,
    "target_public_version": "1.0.0",
    "public_release_version_frozen": false,
    "play_console_version_code_unused_confirmed": false,
    "distribution_format": "AAB",
    "debug_emulator_architectures": ["arm64-v8a", "x86_64"],
    "play_release_architectures": ["arm64-v8a"],
    "toolchain": {
      "godot": "4.7.1-stable",
      "min_sdk": 24,
      "compile_sdk": 36,
      "target_sdk": 36,
      "android_build_tools": "36.1.0",
      "preset_values_explicit": true,
      "release_workflow_installs_sdk_explicitly": true,
      "policy_recheck_before_public_release": true
    }
  },
  "versioning": {
    "name_policy": "semantic versioning",
    "code_policy": "strictly monotonically increasing integer",
    "identity_contract": "mobile/release_identity.json",
    "gate": "tools/release_version_identity_gate.py",
    "public_release_must_be_stable_semver": true,
    "target_first_public_version": "1.0.0",
    "freeze_must_happen_before_11_10": true,
    "version_change_after_11_10_requires_new_11_10": true,
    "play_console_unused_version_code_confirmation_required": true,
    "rc_freeze_pending": true
  },
  "signing": {
    "identity_contract": "product/release_signing_identity.json",
    "gate": "tools/release_signing_identity_gate.py",
    "release_keystore_committed": false,
    "release_credentials_committed": false,
    "protected_secret_names": [
      "VEREDAS_ANDROID_KEYSTORE_B64",
      "VEREDAS_ANDROID_KEY_ALIAS",
      "VEREDAS_ANDROID_KEYSTORE_PASSWORD"
    ],
    "temporary_keystore_path_in_ci": "/tmp/veredas-release/upload.keystore",
    "temporary_keystore_destroyed_after_job": true,
    "signed_aab_workflow": ".github/workflows/veredas-release-aab.yml",
    "signature_verification": "jarsigner -verify -strict -verbose -certs",
    "play_app_signing_required": true,
    "upload_key_role": "developer-held key signs AAB uploaded to Play",
    "play_app_signing_key_role": "Google Play-held key signs delivered APKs",
    "upload_key_minimum": "RSA >= 2048 bits",
    "upload_certificate_minimum_validity_years": 25,
    "app_signing_certificate_required_expiry_after_utc": "2033-10-22T00:00:00Z",
    "upload_and_app_signing_certificates_must_differ": true,
    "upload_certificate_sha256": "PENDING_PLAY_UPLOAD_CERT_SHA256",
    "app_signing_certificate_sha256": "PENDING_PLAY_APP_SIGNING_CERT_SHA256",
    "upload_certificate_registered_in_play_console": false,
    "play_app_signing_configured": false,
    "redundant_encrypted_upload_keystore_backups_verified": false,
    "private_keys_as_release_evidence_forbidden": true
  },
  "release_binding": {
    "11_10_certified_head_must_be_ancestor_of_release_head": true,
    "11_10_release_input_manifest_required": true,
    "11_10_release_input_aggregate_must_equal_release_aggregate": true,
    "explicit_11_10_workflow_run_id_required": true,
    "evidence_only_commits_after_11_10_allowed_if_fingerprint_unchanged": true,
    "runtime_build_or_version_change_after_11_10_requires_new_11_10": true,
    "rc_binding_gate": "tools/release_rc_binding_gate.py",
    "aab_signer_certificate_extracted_from_artifact": true,
    "aab_signer_must_match_frozen_upload_certificate_sha256": true
  },
  "guards": [
    "tools/validate_android_export.py",
    "tools/release_version_identity_gate.py",
    "tools/release_signing_identity_gate.py",
    "tools/release_rc_binding_gate.py",
    "tools/release_input_fingerprint.py",
    "tools/platform_compliance_gate.py",
    "tools/roadmap_state_consistency.py",
    "tools/qa_release_candidate_gate.py",
    "tools/validate_canonical.py"
  ],
  "preflight_workflow": ".github/workflows/veredas-release-contract-preflight.yml",
  "completion_requirements": [
    "recheck target API and Android toolchain policy immediately before public release",
    "create a dedicated RSA >=2048 upload keystore with at least 25 years certificate validity and store redundant encrypted backups outside the repository",
    "configure protected release environment secrets",
    "confirm application id acceptance in Play Console",
    "freeze current version to 1.0.0 with a Play-confirmed unused monotonically increasing version code before 11.10",
    "obtain 11.10 PASS with that frozen version and persist its release-input fingerprint",
    "enroll in Google Play App Signing and register a distinct upload certificate",
    "freeze and record SHA-256 fingerprints/validity evidence for upload and app-signing certificates; app-signing certificate must exceed 2033-10-22",
    "allow later signing/console evidence commits only while the 11.10-certified runtime/build fingerprint remains identical",
    "produce signed AAB from unchanged certified inputs and prove the signer extracted from the AAB matches the frozen upload certificate",
    "record Play App Signing configuration and delivered-app certificate identity"
  ],
  "pass_recorded": false
}
